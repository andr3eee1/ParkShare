generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PROVIDER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?  // Optional URL to profile picture
  role         Role       @default(USER)
  walletBalance Float     @default(0.0)
  passes       UserPass[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model UserPass {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  passKind    String   // 'commuter', 'night-owl', 'park-plus'
  activeUntil DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, passKind]) // A user can only have one active instance of a specific pass type at a time
}
